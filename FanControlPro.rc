IDD_FANCONTROLPRO_DIALOG DIALOGEX 0, 0, 582, 463
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "FanControl Pro - 蓝天模具智能风扇控制"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "保存配置", IDC_BUTTON_SAVE, 450, 420, 50, 14
    PUSHBUTTON      "重置默认", IDC_BUTTON_RESET, 505, 420, 50, 14
    PUSHBUTTON      "加载配置", IDC_BUTTON_LOAD, 395, 420, 50, 14
    CONTROL         "", IDC_PROGRESS_CPU_TEMP, "msctls_progress32", WS_BORDER, 15, 30, 120, 10
    CONTROL         "", IDC_PROGRESS_GPU_TEMP, "msctls_progress32", WS_BORDER, 15, 60, 120, 10
    LTEXT           "CPU: --°C", IDC_STATIC_CPU_TEMP, 15, 15, 120, 10
    LTEXT           "GPU: --°C", IDC_STATIC_GPU_TEMP, 15, 45, 120, 10
    LTEXT           "CPU RPM: --", IDC_STATIC_CPU_RPM, 15, 80, 120, 10
    LTEXT           "GPU RPM: --", IDC_STATIC_GPU_RPM, 15, 95, 120, 10
    LTEXT           "GPU: --%", IDC_STATIC_GPU_USAGE, 15, 110, 120, 10
    LTEXT           "正在准备启动", IDC_STATIC_STARTUP_STATUS, 15, 125, 120, 20
    
    GROUPBOX        "控制模式", IDC_STATIC, 150, 15, 250, 80
    COMBOBOX        IDC_COMBO_MODE, 160, 35, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "接管控制", IDC_CHECK_TAKEOVER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 160, 65, 70, 10
    CONTROL         "强冷模式", IDC_CHECK_FORCE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 240, 65, 70, 10
    
    GROUPBOX        "手动控制", IDC_STATIC, 150, 100, 250, 80
    LTEXT           "CPU 风扇:", IDC_STATIC, 160, 120, 60, 10
    CONTROL         "", IDC_SLIDER_CPU_FAN, "msctls_trackbar32", TBS_AUTOTICKS | TBS_BOTH | WS_TABSTOP, 220, 115, 150, 20
    EDITTEXT        IDC_EDIT_CPU_FAN, 380, 115, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "GPU 风扇:", IDC_STATIC, 160, 145, 60, 10
    CONTROL         "", IDC_SLIDER_GPU_FAN, "msctls_trackbar32", TBS_AUTOTICKS | TBS_BOTH | WS_TABSTOP, 220, 140, 150, 20
    EDITTEXT        IDC_EDIT_GPU_FAN, 380, 140, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    
    GROUPBOX        "高级设置", IDC_STATIC, 150, 190, 250, 120
    LTEXT           "更新间隔(秒):", IDC_STATIC, 160, 210, 80, 10
    EDITTEXT        IDC_EDIT_INTERVAL, 250, 208, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "过渡温度(°C):", IDC_STATIC, 160, 230, 80, 10
    EDITTEXT        IDC_EDIT_TRANSITION, 250, 228, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "强冷触发温度:", IDC_STATIC, 160, 250, 80, 10
    EDITTEXT        IDC_EDIT_FORCE_TEMP, 250, 248, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "线性模式", IDC_CHECK_LINEAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 160, 270, 70, 10
    CONTROL         "锁定 GPU 频率", IDC_CHECK_LOCK_GPU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 240, 270, 90, 10
    LTEXT           "GPU 频率(MHz):", IDC_STATIC, 160, 290, 80, 10
    EDITTEXT        IDC_EDIT_GPU_FREQUENCY, 250, 288, 60, 14, ES_AUTOHSCROLL | ES_NUMBER
    
    GROUPBOX        "预设方案", IDC_STATIC, 150, 320, 250, 50
    CONTROL         "静音模式", IDC_CHECK_SILENT, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 160, 340, 70, 10
    CONTROL         "性能模式", IDC_CHECK_PERFORMANCE, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 240, 340, 70, 10
    
    GROUPBOX        "最大转速限制", IDC_STATIC, 150, 380, 250, 50
    CONTROL         "", IDC_MAX_DUTY_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | TBS_BOTH | WS_TABSTOP, 160, 400, 180, 20
    EDITTEXT        IDC_EDIT_MAX_DUTY, 350, 400, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    
    CONTROL         "开机自启", IDC_CHECK_AUTORUN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 450, 15, 70, 10
    PUSHBUTTON      "高级模式", IDC_BUTTON_ADVANCED, 450, 40, 70, 14
END

IDD_ABOUTBOX DIALOGEX 0, 0, 250, 120
